# Pull Up — environment template.
# Copy to .env.local (gitignored) and fill in real values. Never commit secrets.

# ----------------------------------------------------------------------------
# Public (client-safe). The browser receives these at runtime via
# /api/auth/config so the PKCE Supabase client can be created. Safe to expose.
# ----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------------
# SERVER-ONLY SECRET. Never sent to the browser, never prefixed public, never
# logged, never committed. Used only by server API routes (service role).
# ----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# Optional and intentionally disabled — no AI functionality is used.
OPENAI_API_KEY=
